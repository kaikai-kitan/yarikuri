# Anthropic API key (server-side only — do NOT prefix with VITE_)
# Vercel: Settings → Environment Variables に同じ名前で登録してください
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 楽天ウェブサービス (レシピリンク機能。未設定なら機能ごと無効になります)
# https://webservice.rakuten.co.jp/app/list で発行
# 新ゲートウェイ (openapi.rakuten.co.jp) は両方必須です
RAKUTEN_APPLICATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RAKUTEN_ACCESS_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx

# 1 にすると AI を呼ばずに定型データを返します（APIキー不要・開発用）
# 本番では設定しないでください
MOCK_AI=0
